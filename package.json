{
  "name": "dsh-memewiki",
  "version": "0.1.0",
  "description": "梗百科：内置 6668 条梗/黑话词库，自动查梗并注入上下文，让模型认得群里的梗，不硬猜。移植自 AstrBot 的 astrbot_plugin_memewiki。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "meme",
    "梗百科",
    "meme-wiki"
  ],
  "author": "thawline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thawline/dsh-memewiki.git"
  },
  "homepage": "https://github.com/thawline/dsh-memewiki#readme",
  "bugs": {
    "url": "https://github.com/thawline/dsh-memewiki/issues"
  }
}
